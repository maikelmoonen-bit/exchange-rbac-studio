<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ExchangeRbacStudio.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExchangeRbacStudio.Application\ExchangeRbacStudio.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Graph" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fixed, allowlisted PowerShell dispatcher executed by the isolated pwsh host process. -->
    <None Include="Exchange\Host\ExchangeHost.ps1" CopyToOutputDirectory="PreserveNewest" Link="PowerShell\ExchangeHost.ps1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ExchangeRbacStudio.Tests" />
  </ItemGroup>

</Project>
