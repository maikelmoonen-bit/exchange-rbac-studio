<ui:FluentWindow x:Class="ExchangeRbacStudio.App.Views.Dialogs.ConnectDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:ExchangeRbacStudio.App.ViewModels.Dialogs"
                 xmlns:controls="clr-namespace:ExchangeRbacStudio.App.Controls"
                 xmlns:settings="clr-namespace:ExchangeRbacStudio.Application.Settings;assembly=ExchangeRbacStudio.Application"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:ConnectDialogViewModel}"
                 Title="Connect to Microsoft 365" Width="640" SizeToContent="Height" MaxHeight="860"
                 WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 AutomationProperties.AutomationId="ConnectDialog">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TitleBar Title="Connect to Microsoft 365" ShowMaximize="False" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,8,28,16">
                <TextBlock Text="Sign in with your administrator account. Microsoft Entra ID and Exchange Online each open an interactive sign-in in your browser (MFA and Conditional Access are supported). Your password is never entered in this application."
                           Style="{StaticResource SecondaryText}" />

                <TextBlock Text="Environment" Style="{StaticResource LabelText}" Margin="0,18,0,4" />
                <ComboBox ItemsSource="{Binding Environments}" SelectedItem="{Binding SelectedEnvironment}" DisplayMemberPath="DisplayName"
                          IsEnabled="{Binding IsConnecting, Converter={StaticResource InverseBool}}" AutomationProperties.Name="Environment" />

                <TextBlock Text="Tenant (optional)" Style="{StaticResource LabelText}" Margin="0,14,0,4" />
                <ui:TextBox Text="{Binding TenantHint, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="contoso.onmicrosoft.com or tenant ID — leave empty for your home tenant"
                            IsEnabled="{Binding IsConnecting, Converter={StaticResource InverseBool}}" AutomationProperties.Name="Tenant" />

                <TextBlock Text="Microsoft Graph sign-in client" Style="{StaticResource LabelText}" Margin="0,14,0,4" />
                <Border Style="{StaticResource SubtleCard}">
                    <StackPanel>
                        <RadioButton GroupName="Client" IsChecked="{Binding ClientMode, Converter={StaticResource EnumEquals}, ConverterParameter=MicrosoftGraphCommandLineTools}"
                                     AutomationProperties.Name="Microsoft Graph Command Line Tools">
                            <StackPanel>
                                <TextBlock Text="Microsoft Graph Command Line Tools" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding MicrosoftClientId, StringFormat='Microsoft-published public client ({0}), the same client used by Connect-MgGraph. Requires consent for User.Read and Application.Read.All in your tenant.'}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Client" Margin="0,10,0,0" IsChecked="{Binding ClientMode, Converter={StaticResource EnumEquals}, ConverterParameter=Custom}"
                                     AutomationProperties.Name="Organization app registration">
                            <StackPanel>
                                <TextBlock Text="My organization's app registration (recommended for production)" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="Public client with redirect URI http://localhost and delegated permissions User.Read and Application.Read.All." />
                            </StackPanel>
                        </RadioButton>
                        <ui:TextBox Margin="28,8,0,0" Text="{Binding CustomClientId, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Application (client) ID"
                                    FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Custom client ID"
                                    IsEnabled="{Binding ClientMode, Converter={StaticResource EnumEquals}, ConverterParameter=Custom}" />
                    </StackPanel>
                </Border>

                <CheckBox Margin="0,12,0,0" IsChecked="{Binding UseWam}" Content="Use Windows Web Account Manager (WAM) for Exchange Online sign-in"
                          ToolTip="WAM enables device-based Conditional Access. If sign-in fails with a window handle error, turn this off to use the system browser." />

                <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:StatusGlyph Kind="{Binding GraphKind}" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock><Run Text="Microsoft Entra ID (Microsoft Graph): " FontWeight="SemiBold" /><Run Text="{Binding GraphStatus, Mode=OneWay}" /></TextBlock>
                                <TextBlock Text="{Binding GraphDetail}" Style="{StaticResource CaptionText}" Visibility="{Binding GraphDetail, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:StatusGlyph Kind="{Binding ExchangeKind}" />
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock><Run Text="Exchange Online (PowerShell 7 host): " FontWeight="SemiBold" /><Run Text="{Binding ExchangeStatus, Mode=OneWay}" /></TextBlock>
                                <TextBlock Text="{Binding ExchangeDetail}" Style="{StaticResource CaptionText}" Visibility="{Binding ExchangeDetail, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <controls:ErrorPanel Error="{Binding Error}" Margin="0,16,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="28,16" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <Grid>
                <controls:LoadingIndicator Text="{Binding BusyMessage}" Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Cancel sign-in" Command="{Binding CancelConnectCommand}" Margin="0,0,8,0"
                               Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Content="Close" Command="{Binding CloseCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="ConnectDialogClose" />
                    <ui:Button Appearance="Primary" Content="Connect" Icon="{ui:SymbolIcon PlugConnected24}" Command="{Binding ConnectCommand}" IsDefault="True"
                               IsEnabled="{Binding IsConnecting, Converter={StaticResource InverseBool}}" AutomationProperties.AutomationId="ConnectDialogConnect" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
