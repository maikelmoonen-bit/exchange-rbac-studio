<UserControl x:Class="ExchangeRbacStudio.App.Views.Pages.ApplicationDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ExchangeRbacStudio.App.ViewModels.Pages"
             xmlns:vmroot="clr-namespace:ExchangeRbacStudio.App.ViewModels"
             xmlns:controls="clr-namespace:ExchangeRbacStudio.App.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:ApplicationDetailViewModel}"
             AutomationProperties.AutomationId="ApplicationDetailPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource PagePadding}">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon ArrowLeft24}" Command="{Binding BackCommand}" VerticalAlignment="Top" Margin="0,4,8,0"
                           ToolTip="Back to applications" AutomationProperties.Name="Back to applications" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <controls:StatusBadge Kind="{Binding PointerKind}" Text="{Binding PointerLabel}" Margin="0,0,8,0" />
                        <controls:StatusBadge Kind="Neutral" Text="{Binding EntraStatus}" Visibility="{Binding EntraStatus, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>
                </StackPanel>
                <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}" Margin="0,0,8,8" />
                    <ui:Button Content="Test" Icon="{ui:SymbolIcon ShieldCheckmark24}" Command="{Binding TestAuthorizationCommand}" Margin="0,0,8,8" ToolTip="Open the Authorization Tester for this application" AutomationProperties.Name="Test authorization" />
                    <ui:Button Content="Add access" Icon="{ui:SymbolIcon Add24}" Command="{Binding AddAccessCommand}" Margin="0,0,8,8"
                               ToolTip="Configure additional scoped access for this application" />
                    <ui:Button Appearance="Primary" Content="Modify access" Icon="{ui:SymbolIcon Edit24}" Command="{Binding ModifyAccessCommand}" Margin="0,0,8,8"
                               ToolTip="Change the mailboxes or permissions of the application's exact-identity scope" />
                    <ui:Button Content="Remove…" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveConfigurationCommand}" Margin="0,0,0,8" ToolTip="Plan removal of this application's Exchange RBAC configuration (reviewed before anything changes)" AutomationProperties.Name="Remove configuration" />
                </WrapPanel>
            </Grid>

            <controls:ErrorPanel Error="{Binding Error}" />
            <controls:LoadingIndicator Text="{Binding BusyMessage}" Margin="0,0,0,16" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Visibility="{Binding Profile, Converter={StaticResource NullToVisibility}}">
                <!-- Identity -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Application (client) ID" Style="{StaticResource LabelText}" />
                            <controls:CopyableText Text="{Binding AppId}" AutomationProperties.Name="Application ID" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Service principal object ID (Enterprise Application)" Style="{StaticResource LabelText}" />
                            <controls:CopyableText Text="{Binding ObjectId}" AutomationProperties.Name="Service principal object ID" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Warnings -->
                <Border Style="{StaticResource Card}" Visibility="{Binding Findings.Count, Converter={StaticResource CountToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Warnings" Style="{StaticResource SectionTitleText}" AutomationProperties.HeadingLevel="Level2" />
                        <ItemsControl ItemsSource="{Binding Findings}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SecurityFindingItem}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:StatusGlyph Kind="{Binding Kind}" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" />
                                            <TextBlock Text="{Binding Remediation}" Style="{StaticResource CaptionText}" FontStyle="Italic" Margin="0,2,0,0"
                                                       Visibility="{Binding Remediation, Converter={StaticResource NullToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Effective access matrix -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Effective access" Style="{StaticResource SectionTitleText}" AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                           Text="Exchange RBAC and Microsoft Entra ID are independent, additive authorization systems. Cells distinguish configured scope membership, observed results from Test-ServicePrincipalAuthorization, and tenant-wide Entra ID grants." />
                            </StackPanel>
                            <ui:Button HorizontalAlignment="Right" VerticalAlignment="Top" Content="Run authorization tests" Icon="{ui:SymbolIcon Beaker24}" Command="{Binding RunTestsCommand}"
                                       ToolTip="Runs Test-ServicePrincipalAuthorization for up to 25 scoped mailboxes" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <controls:StatusBadge Kind="Success" Text="RBAC (tested)" Margin="0,0,6,0" />
                            <controls:StatusBadge Kind="Info" Text="RBAC (configured)" Margin="0,0,6,0" />
                            <controls:StatusBadge Kind="Critical" Text="Tenant-wide (Entra or org-wide RBAC)" Margin="0,0,6,0" />
                            <controls:StatusBadge Kind="Neutral" Text="No access" />
                        </StackPanel>
                        <Border Style="{StaticResource SubtleCard}" Margin="0,8,0,0" Visibility="{Binding TestSummary, Converter={StaticResource NullToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <controls:StatusGlyph Kind="{Binding TestSummaryKind}" />
                                <TextBlock Text="{Binding TestSummary}" Margin="10,0,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding MatrixNote}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Visibility="{Binding MatrixNote, Converter={StaticResource NullToVisibility}}" />

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,14,0,0">
                            <StackPanel MinWidth="600">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Mailbox" Style="{StaticResource LabelText}" />
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding MatrixHeaders}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" Columns="{Binding DataContext.MatrixColumns, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Style="{StaticResource LabelText}" Margin="4,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding MatrixRows}" AutomationProperties.Name="Effective access matrix">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MatrixRowItem}">
                                            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="280" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Mailbox}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Mailbox}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAllOthers}" Value="True">
                                                                        <Setter Property="FontStyle" Value="Italic" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Rows="1" Columns="{Binding DataContext.MatrixColumns, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:MatrixCellItem}">
                                                                <controls:StatusBadge Kind="{Binding Kind}" Text="{Binding Label}" ToolTip="{Binding ToolTip}" Margin="4,0" HorizontalAlignment="Stretch" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Exchange RBAC role assignments -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Exchange RBAC roles" Style="{StaticResource SectionTitleText}" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Text="No application roles are assigned in Exchange Online." Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                   Visibility="{Binding Assignments.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}" />
                        <ItemsControl ItemsSource="{Binding Assignments}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AssignmentItem}">
                                    <Border Style="{StaticResource SubtleCard}" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Role}" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource CaptionText}"><Run Text="Scope: " /><Run Text="{Binding Scope, Mode=OneWay}" /><Run Text="  ·  Assignment: " /><Run Text="{Binding Name, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" /></TextBlock>
                                            </StackPanel>
                                            <controls:StatusBadge Grid.Column="1" Kind="{Binding Kind}" Text="{Binding Status}" Margin="8,0" />
                                            <ui:Button Grid.Column="2" Appearance="Transparent" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveCommand}"
                                                       ToolTip="Remove this role assignment" AutomationProperties.Name="{Binding Role, StringFormat='Remove {0}'}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Linked scopes and authorized mailboxes -->
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Linked management scopes" Style="{StaticResource SectionTitleText}" AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock Text="None." Style="{StaticResource CaptionText}" Margin="0,8,0,0" Visibility="{Binding Scopes.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}" />
                                <ItemsControl ItemsSource="{Binding Scopes}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ScopeItem}">
                                            <Border Style="{StaticResource SubtleCard}" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <controls:StatusBadge HorizontalAlignment="Right" Kind="{Binding RiskKind}" Text="{Binding RiskLabel}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Filter}" Style="{StaticResource MonoText}" Margin="0,6,0,0" />
                                                    <TextBlock Text="{Binding MemberSummary}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Authorized mailboxes (Exchange RBAC)" Style="{StaticResource SectionTitleText}" AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock Text="Recipients matched by the application's management scope filters (recipient preview)." Style="{StaticResource CaptionText}" Margin="0,4,0,8" />
                                <TextBlock Text="None." Style="{StaticResource CaptionText}" Visibility="{Binding AuthorizedMailboxes.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}" />
                                <ItemsControl ItemsSource="{Binding AuthorizedMailboxes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <ui:SymbolIcon Symbol="Mail24" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding}" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Entra permissions -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Microsoft Entra ID application permissions" Style="{StaticResource SectionTitleText}" AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock Text="Admin-consented app role assignments (appRoleAssignments) — not merely requested permissions." Style="{StaticResource CaptionText}" Margin="0,4,0,8" />
                            <ui:InfoBar Severity="Warning" IsClosable="False" IsOpen="True" Title="Not verified" Message="{Binding GrantsError}"
                                        Visibility="{Binding GrantsError, Converter={StaticResource NullToVisibility}}" />
                            <TextBlock Text="No application permissions are granted." Style="{StaticResource CaptionText}"
                                       Visibility="{Binding Grants.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}" />
                            <ItemsControl ItemsSource="{Binding Grants}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:GrantItem}">
                                        <Grid Margin="0,0,0,8" ToolTip="{Binding Explanation}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Permission}" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" />
                                                <TextBlock Text="{Binding Resource}" Style="{StaticResource CaptionText}" />
                                            </StackPanel>
                                            <controls:StatusBadge Grid.Column="1" Kind="{Binding Kind}" Text="{Binding Reach}" VerticalAlignment="Top" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
