<UserControl x:Class="ExchangeRbacStudio.App.Views.Pages.ChangeHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ExchangeRbacStudio.App.ViewModels.Pages"
             xmlns:controls="clr-namespace:ExchangeRbacStudio.App.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:ChangeHistoryViewModel}"
             AutomationProperties.AutomationId="ChangeHistoryPage">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:Button Content="Verify integrity" Icon="{ui:SymbolIcon ShieldCheckmark24}" Command="{Binding VerifyIntegrityCommand}" Margin="0,0,8,0"
                           ToolTip="Verify the SHA-256 hash chain of the audit log" />
                <ui:Button Content="Audit folder" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenAuditFolderCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Reports folder" Icon="{ui:SymbolIcon DocumentData24}" Command="{Binding OpenReportsFolderCommand}" Margin="0,0,8,0" />
                <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
            <controls:ErrorPanel Error="{Binding Error}" />
            <Border Style="{StaticResource SubtleCard}" Margin="0,0,0,12" Visibility="{Binding IntegrityMessage, Converter={StaticResource NullToVisibility}}">
                <controls:StatusMessage Kind="{Binding IntegrityKind}" Text="{Binding IntegrityMessage}" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}" PlaceholderText="Filter by operation, target or administrator"
                        Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True" AutomationProperties.Name="Filter history" />
            <CheckBox Grid.Column="1" Margin="12,0,0,0" Content="All tenants" IsChecked="{Binding AllTenants}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CaptionText}" Text="{Binding AuditLocation, StringFormat='Audit log: {0}'}" />
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Margin="0" Padding="8">
                <Grid>
                    <controls:EmptyState Symbol="History24" Title="No history yet" Message="Sessions, validations, changes and verifications are recorded here."
                                         Visibility="{Binding Items.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}" />
                    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Style="{StaticResource PlainListBox}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="History" AutomationProperties.AutomationId="HistoryList">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HistoryItem}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource CaptionText}"><Run Text="{Binding Time, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Category, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Administrator, Mode=OneWay}" /></TextBlock>
                                        <TextBlock Text="{Binding Tenant}" Style="{StaticResource CaptionText}" />
                                    </StackPanel>
                                    <controls:StatusBadge Grid.Column="1" Kind="{Binding Kind}" Text="{Binding OutcomeLabel}" VerticalAlignment="Top" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Margin="0">
                    <Grid>
                        <TextBlock Text="Select an entry to see its audit records." Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                        <DataGrid ItemsSource="{Binding SelectedItem.Entries}" Style="{StaticResource StudioDataGrid}" RowHeight="48"
                                  Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibility}}" AutomationProperties.Name="Audit records">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="Auto" />
                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="Auto" />
                                <DataGridTemplateColumn Header="Outcome" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:AuditEntryItem}">
                                            <controls:StatusBadge Kind="{Binding Kind}" Text="{Binding Outcome}" Margin="4,0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Details" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type vm:AuditEntryItem}">
                                            <StackPanel VerticalAlignment="Center" Margin="4,0" ToolTip="{Binding Command}">
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" />
                                                <TextBlock Text="{Binding Command}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="{Binding Command, Converter={StaticResource NullToVisibility}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Change reports" Style="{StaticResource SubsectionTitleText}" Margin="0,0,0,8" />
                        <Grid>
                            <TextBlock Text="No reports have been generated yet." Style="{StaticResource CaptionText}"
                                       Visibility="{Binding Reports.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}" />
                            <ListBox ItemsSource="{Binding Reports}" Style="{StaticResource PlainListBox}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ReportFileItem}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding When}" Style="{StaticResource CaptionText}" />
                                            </StackPanel>
                                            <ui:Button Grid.Column="1" Content="Open" Icon="{ui:SymbolIcon Open24}"
                                                       Command="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
