<UserControl x:Class="ExchangeRbacStudio.App.Views.Pages.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ExchangeRbacStudio.App.ViewModels.Pages"
             xmlns:controls="clr-namespace:ExchangeRbacStudio.App.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:ApplicationsViewModel}"
             AutomationProperties.AutomationId="ApplicationsPage">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" IsEnabled="{Binding IsExchangeConnected}" />
                <ui:Button Appearance="Primary" Content="Configure scoped access" Icon="{ui:SymbolIcon Add24}" Command="{Binding ConfigureAccessCommand}" />
            </StackPanel>
        </Grid>

        <controls:ErrorPanel Grid.Row="1" Error="{Binding Error}" />

        <Grid Grid.Row="2" Margin="0,0,0,12" Visibility="{Binding IsExchangeConnected, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="460" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter by name, application ID, object ID, role or scope"
                        Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True" AutomationProperties.Name="Filter applications" AutomationProperties.AutomationId="ApplicationsFilter" />
            <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="180" ItemsSource="{Binding FilterModes}" SelectedItem="{Binding FilterMode}" AutomationProperties.Name="Filter mode" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <controls:LoadingIndicator Text="{Binding BusyMessage}" Margin="0,0,16,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3">
            <Border Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding IsExchangeConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <controls:EmptyState Symbol="PlugDisconnected24" Title="Not connected" Message="Connect to Exchange Online to list applications with RBAC for Applications configuration.">
                    <ui:Button Appearance="Primary" Content="Connect" Command="{Binding DataContext.Session.ConnectCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </controls:EmptyState>
            </Border>
            <Grid Visibility="{Binding IsExchangeConnected, Converter={StaticResource BoolToVisibility}}">
                <controls:EmptyState Symbol="AppGeneric24" Title="No applications yet" VerticalAlignment="Top"
                                     Message="No Exchange service principal pointers exist in this tenant. Configure scoped access to register an application."
                                     Visibility="{Binding Rows.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}" />
                <DataGrid x:Name="Grid" ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedRow}" Style="{StaticResource StudioDataGrid}" RowHeight="52"
                          Visibility="{Binding Rows.Count, Converter={StaticResource CountToVisibility}}" AutomationProperties.Name="Applications" AutomationProperties.AutomationId="ApplicationsGrid">
                    <DataGrid.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenCommand}" CommandParameter="{Binding SelectedItem, ElementName=Grid}" />
                        <KeyBinding Key="Enter" Command="{Binding OpenCommand}" CommandParameter="{Binding SelectedItem, ElementName=Grid}" />
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Application" Width="2*" SortMemberPath="DisplayName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:ApplicationRow}">
                                    <StackPanel VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding AppId}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Roles" Binding="{Binding Roles}" Width="2*" />
                        <DataGridTextColumn Header="Scopes" Binding="{Binding Scopes}" Width="1.6*" />
                        <DataGridTextColumn Header="Assignments" Binding="{Binding AssignmentCount}" Width="Auto" />
                        <DataGridTemplateColumn Header="Assessment" Width="Auto" SortMemberPath="RiskLabel">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:ApplicationRow}">
                                    <controls:StatusBadge Kind="{Binding RiskKind}" Text="{Binding RiskLabel}" ToolTip="{Binding RiskDetail}" Margin="4,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:ApplicationRow}">
                                    <ui:Button Content="Open" Icon="{ui:SymbolIcon ChevronRight24}" Margin="4,0"
                                               Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                               AutomationProperties.Name="{Binding DisplayName, StringFormat='Open {0}'}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
