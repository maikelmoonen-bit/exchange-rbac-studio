<UserControl x:Class="ExchangeRbacStudio.App.Views.Pages.ScopesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ExchangeRbacStudio.App.ViewModels.Pages"
             xmlns:controls="clr-namespace:ExchangeRbacStudio.App.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:ScopesViewModel}"
             AutomationProperties.AutomationId="ScopesPage">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleText}" />
            </StackPanel>
            <ui:Button Grid.Column="1" VerticalAlignment="Top" Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsExchangeConnected}" />
        </Grid>

        <controls:ErrorPanel Grid.Row="1" Error="{Binding Error}" />

        <Grid Grid.Row="2" Margin="0,0,0,12" Visibility="{Binding IsExchangeConnected, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter by name, filter text or application" Icon="{ui:SymbolIcon Search24}"
                        ClearButtonEnabled="True" AutomationProperties.Name="Filter scopes" />
            <CheckBox Grid.Column="1" Margin="12,0,0,0" Content="Only scopes used by applications" IsChecked="{Binding OnlyApplicationScopes}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <controls:LoadingIndicator Text="{Binding BusyMessage}" Margin="0,0,16,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding IsExchangeConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <controls:EmptyState Symbol="PlugDisconnected24" Title="Not connected" Message="Connect to Exchange Online to inspect management scopes.">
                <ui:Button Appearance="Primary" Content="Connect" Command="{Binding DataContext.Session.ConnectCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </controls:EmptyState>
        </Border>

        <Grid Grid.Row="3" Visibility="{Binding IsExchangeConnected, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <DataGrid ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedRow}" Style="{StaticResource StudioDataGrid}"
                      AutomationProperties.Name="Management scopes" AutomationProperties.AutomationId="ScopesGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Scope" Binding="{Binding Name}" Width="2*" MinWidth="200" FontWeight="SemiBold" />
                    <DataGridTemplateColumn Header="Filter assessment" Width="Auto" SortMemberPath="RiskLabel">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:ScopeRow}">
                                <controls:StatusBadge Kind="{Binding RiskKind}" Text="{Binding RiskLabel}" Margin="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Assignments" Binding="{Binding AssignmentCount}" Width="Auto" />
                    <DataGridTextColumn Header="Applications" Binding="{Binding Applications}" Width="1.5*" />
                    <DataGridTextColumn Header="Recipient filter" Binding="{Binding Filter}" Width="2*" FontFamily="{StaticResource MonoFont}" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" VerticalAlignment="Stretch">
                <Grid>
                    <TextBlock Text="Select a scope to inspect it." Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding SelectedRow, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedRow, Converter={StaticResource NullToVisibility}}">
                        <StackPanel DataContext="{Binding SelectedRow}">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitleText}" TextWrapping="Wrap" />
                            <controls:StatusBadge Kind="{Binding RiskKind}" Text="{Binding RiskLabel}" Margin="0,8,0,0" />
                            <TextBlock Text="Recipient restriction filter" Style="{StaticResource LabelText}" Margin="0,16,0,4" />
                            <Border Style="{StaticResource CodeBlock}">
                                <controls:CopyableText Text="{Binding Filter}" />
                            </Border>
                            <TextBlock Text="Analysis" Style="{StaticResource LabelText}" Margin="0,16,0,4" />
                            <ItemsControl ItemsSource="{Binding Analysis.Flags}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" Margin="0,0,0,6" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Role assignments using this scope" Style="{StaticResource LabelText}" Margin="0,12,0,4" />
                            <TextBlock Text="None (not used by application role assignments)." Style="{StaticResource CaptionText}"
                                       Visibility="{Binding AssignmentCount, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}" />
                            <ItemsControl ItemsSource="{Binding Assignments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,4"><Run Text="{Binding Role, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding Name, Mode=OneWay}" /></TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,16,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="Resolve matching recipients" Icon="{ui:SymbolIcon PeopleSearch24}" Command="{Binding ResolveMembersCommand}" Margin="0,0,8,0" />
                                    <ui:Button Content="Remove scope…" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveScopeCommand}" ToolTip="Checks every role assignment that uses this scope before planning a removal" />
                                </StackPanel>
                                <TextBlock Text="{Binding MemberSummary}" Style="{StaticResource CaptionText}" Margin="0,10,0,6" Visibility="{Binding MemberSummary, Converter={StaticResource NullToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Members}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:RecipientItem}">
                                            <TextBlock Margin="0,2" Style="{StaticResource CaptionText}"><Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Address, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Type, Mode=OneWay}" /></TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
