<UserControl x:Class="ExchangeRbacStudio.App.Views.Pages.RoleAssignmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ExchangeRbacStudio.App.ViewModels.Pages"
             xmlns:controls="clr-namespace:ExchangeRbacStudio.App.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:RoleAssignmentsViewModel}"
             AutomationProperties.AutomationId="RoleAssignmentsPage">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowClockwise24}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" IsEnabled="{Binding IsExchangeConnected}" />
                <ui:Button Appearance="Primary" Content="New assignment" Icon="{ui:SymbolIcon Add24}" Command="{Binding NewAssignmentCommand}" />
            </StackPanel>
        </Grid>

        <controls:ErrorPanel Grid.Row="1" Error="{Binding Error}" />

        <Grid Grid.Row="2" Margin="0,0,0,12" Visibility="{Binding IsExchangeConnected, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Filter by application, role, scope or name" Icon="{ui:SymbolIcon Search24}"
                        ClearButtonEnabled="True" AutomationProperties.Name="Filter role assignments" />
            <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="240" ItemsSource="{Binding RoleFilters}" SelectedItem="{Binding RoleFilter}" AutomationProperties.Name="Role filter" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <controls:LoadingIndicator Text="{Binding BusyMessage}" Margin="0,0,16,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding IsExchangeConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <controls:EmptyState Symbol="PlugDisconnected24" Title="Not connected" Message="Connect to Exchange Online to manage application role assignments.">
                <ui:Button Appearance="Primary" Content="Connect" Command="{Binding DataContext.Session.ConnectCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            </controls:EmptyState>
        </Border>

        <Grid Grid.Row="3" Visibility="{Binding IsExchangeConnected, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <DataGrid ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedRow}" Style="{StaticResource StudioDataGrid}"
                      AutomationProperties.Name="Role assignments" AutomationProperties.AutomationId="AssignmentsGrid">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Application" Binding="{Binding Application}" Width="1.3*" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="1.4*" />
                    <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="1.4*" />
                    <DataGridTemplateColumn Header="Scope type" Width="Auto" SortMemberPath="ScopeKind">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:AssignmentRow}">
                                <controls:StatusBadge Kind="{Binding ScopeKindStatus}" Text="{Binding ScopeKind}" Margin="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Status" Width="Auto" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:AssignmentRow}">
                                <controls:StatusBadge Kind="{Binding StatusKind}" Text="{Binding Status}" Margin="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Assignment" Binding="{Binding Name}" Width="1.3*" FontFamily="{StaticResource MonoFont}" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                <Grid>
                    <TextBlock Text="Select an assignment to manage it." Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding SelectedRow, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedRow, Converter={StaticResource NullToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedRow.Role}" Style="{StaticResource SectionTitleText}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedRow.Application}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                            <TextBlock Text="Assignment identity" Style="{StaticResource LabelText}" Margin="0,16,0,4" />
                            <controls:CopyableText Text="{Binding SelectedRow.Identity}" />
                            <TextBlock Text="Resource scope" Style="{StaticResource LabelText}" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding SelectedRow.Scope}" Style="{StaticResource BodyText}" />
                            <TextBlock Text="Created" Style="{StaticResource LabelText}" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding SelectedRow.Created, TargetNullValue='Unknown'}" Style="{StaticResource BodyText}" />
                            <ui:Button Content="Open application" Icon="{ui:SymbolIcon AppGeneric24}" Command="{Binding OpenApplicationCommand}" Margin="0,16,0,0" />

                            <Border Style="{StaticResource Divider}" Margin="0,20" />
                            <TextBlock Text="Change scope" Style="{StaticResource SubsectionTitleText}" />
                            <TextBlock Text="Set-ManagementRoleAssignment -CustomResourceScope. Review the target scope's membership on the Management Scopes page first." Style="{StaticResource CaptionText}" Margin="0,4,0,8" />
                            <ComboBox ItemsSource="{Binding TargetScopes}" SelectedItem="{Binding TargetScope}" AutomationProperties.Name="Target scope" />
                            <ui:Button Content="Review scope change" Icon="{ui:SymbolIcon Edit24}" Command="{Binding ChangeScopeCommand}" Margin="0,8,0,0" />

                            <Border Style="{StaticResource Divider}" Margin="0,20" />
                            <TextBlock Text="Remove assignment" Style="{StaticResource SubsectionTitleText}" />
                            <TextBlock Text="The application loses this role on this scope. The scope itself is kept." Style="{StaticResource CaptionText}" Margin="0,4,0,8" />
                            <ui:Button Content="Review removal…" Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveCommand}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
