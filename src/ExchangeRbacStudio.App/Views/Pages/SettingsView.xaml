<UserControl x:Class="ExchangeRbacStudio.App.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ExchangeRbacStudio.App.ViewModels.Pages"
             xmlns:controls="clr-namespace:ExchangeRbacStudio.App.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             AutomationProperties.AutomationId="SettingsPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="1000" HorizontalAlignment="Left">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <ui:Button Content="Restore defaults" Command="{Binding ResetCommand}" Margin="0,0,8,0" />
                    <ui:Button Appearance="Primary" Content="Save" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="SaveSettings" />
                </StackPanel>
            </Grid>

            <controls:ErrorPanel Error="{Binding Error}" />
            <Border Style="{StaticResource SubtleCard}" Margin="0,0,0,16" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}">
                <controls:StatusMessage Kind="{Binding StatusKind}" Text="{Binding StatusMessage}" />
            </Border>
            <ItemsControl ItemsSource="{Binding ValidationErrors}" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:InfoBar Severity="Error" IsOpen="True" IsClosable="False" Message="{Binding}" Margin="0,0,0,6" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource SectionTitleText}" AutomationProperties.HeadingLevel="Level2" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <RadioButton GroupName="Theme" Content="Use system setting" Margin="0,0,20,0" IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=System}" />
                        <RadioButton GroupName="Theme" Content="Light" Margin="0,0,20,0" IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Light}"
                                     AutomationProperties.AutomationId="ThemeLight" />
                        <RadioButton GroupName="Theme" Content="Dark" IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Dark}"
                                     AutomationProperties.AutomationId="ThemeDark" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Connection" Style="{StaticResource SectionTitleText}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="Changes apply the next time you connect." Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                    <TextBlock Text="Environment" Style="{StaticResource LabelText}" Margin="0,14,0,4" />
                    <ComboBox ItemsSource="{Binding Environments}" SelectedItem="{Binding Environment}" DisplayMemberPath="DisplayName" MaxWidth="420" HorizontalAlignment="Left" MinWidth="320" />
                    <TextBlock Text="Tenant (optional)" Style="{StaticResource LabelText}" Margin="0,14,0,4" />
                    <ui:TextBox Text="{Binding TenantHint, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="contoso.onmicrosoft.com or tenant ID" MaxWidth="420" HorizontalAlignment="Left" MinWidth="320" />
                    <TextBlock Text="Microsoft Graph sign-in client" Style="{StaticResource LabelText}" Margin="0,14,0,4" />
                    <RadioButton GroupName="Client" IsChecked="{Binding ClientMode, Converter={StaticResource EnumEquals}, ConverterParameter=MicrosoftGraphCommandLineTools}">
                        <TextBlock><Run Text="Microsoft Graph Command Line Tools " /><Run Text="{Binding MicrosoftClientId, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12" /></TextBlock>
                    </RadioButton>
                    <RadioButton GroupName="Client" Margin="0,6,0,0" Content="My organization's app registration" IsChecked="{Binding ClientMode, Converter={StaticResource EnumEquals}, ConverterParameter=Custom}" />
                    <ui:TextBox Margin="28,6,0,0" Text="{Binding CustomClientId, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Application (client) ID" FontFamily="{StaticResource MonoFont}"
                                MaxWidth="420" HorizontalAlignment="Left" MinWidth="320" />
                    <TextBlock Margin="28,4,0,0" Style="{StaticResource CaptionText}"
                               Text="Register a public client with redirect URI http://localhost and delegated permissions User.Read and Application.Read.All (admin consent required)." />
                    <CheckBox Margin="0,14,0,0" IsChecked="{Binding UseWam}" Content="Use Windows Web Account Manager (WAM) for Exchange Online sign-in" />
                    <TextBlock Text="PowerShell 7 (pwsh.exe)" Style="{StaticResource LabelText}" Margin="0,14,0,4" />
                    <Grid MaxWidth="640" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="320" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding PowerShellPath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Automatic detection" FontFamily="{StaticResource MonoFont}" />
                        <ui:Button Grid.Column="1" Content="Browse…" Command="{Binding BrowsePowerShellCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding DetectedPowerShell, StringFormat='Detected: {0}'}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                    <TextBlock Text="Minimum ExchangeOnlineManagement version" Style="{StaticResource LabelText}" Margin="0,14,0,4" />
                    <ui:TextBox Text="{Binding MinimumModuleVersion, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Naming conventions" Style="{StaticResource SectionTitleText}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" Text="Tokens: {APP}, {APPID}, {APPID8}, {CATEGORY}, {ROLE}, {COUNT}, {DATE}. Names are sanitized to letters, digits, '_', '-' and '.', and limited to 64 characters." />
                    <TextBlock Text="Management scope name template" Style="{StaticResource LabelText}" Margin="0,14,0,4" />
                    <ui:TextBox Text="{Binding ScopeNameTemplate, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" MaxWidth="520" HorizontalAlignment="Left" MinWidth="360" />
                    <TextBlock Text="Role assignment name template" Style="{StaticResource LabelText}" Margin="0,14,0,4" />
                    <ui:TextBox Text="{Binding AssignmentNameTemplate, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" MaxWidth="520" HorizontalAlignment="Left" MinWidth="360" />
                    <Border Style="{StaticResource CodeBlock}" Margin="0,10,0,0" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding NamePreview}" Style="{StaticResource MonoText}" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Scoping" Style="{StaticResource SectionTitleText}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="Exact-identity filter strategy" Style="{StaticResource LabelText}" Margin="0,12,0,4" />
                    <ComboBox ItemsSource="{Binding Strategies}" SelectedItem="{Binding Strategy}" MaxWidth="520" HorizontalAlignment="Left" MinWidth="360">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StrategyOption}">
                                <StackPanel MaxWidth="480">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                               Text="PrimarySmtpAddress is intentionally not offered: Microsoft documents that it also matches proxy addresses. Broad, attribute- or wildcard-based scopes are disabled in this release." />
                    <TextBlock Text="Maximum mailboxes per scope" Style="{StaticResource LabelText}" Margin="0,14,0,4" />
                    <ui:NumberBox Value="{Binding MaxMailboxes}" Minimum="1" Maximum="500" Width="160" HorizontalAlignment="Left" MaxDecimalPlaces="0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Safety" Style="{StaticResource SectionTitleText}" AutomationProperties.HeadingLevel="Level2" />
                    <CheckBox Margin="0,12,0,0" IsChecked="{Binding RequireTypedConfirmation}" Content="Require typing the object name to confirm removals" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="28,4,0,0" Text="Explicit confirmation of the target tenant is always required for every change, and every change is recorded in the audit log." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Diagnostics and data locations" Style="{StaticResource SectionTitleText}" AutomationProperties.HeadingLevel="Level2" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Logs" Style="{StaticResource LabelText}" />
                        <TextBlock Grid.Column="1" Text="{Binding LogLocation}" Style="{StaticResource MonoText}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="1" Text="Audit log" Style="{StaticResource LabelText}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AuditLocation}" Style="{StaticResource MonoText}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="2" Text="Reports" Style="{StaticResource LabelText}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReportLocation}" Style="{StaticResource MonoText}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="3" Text="Settings file" Style="{StaticResource LabelText}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SettingsLocation}" Style="{StaticResource MonoText}" />
                    </Grid>
                    <WrapPanel Margin="0,12,0,0">
                        <ui:Button Content="Open logs" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenLogsCommand}" Margin="0,0,8,8" />
                        <ui:Button Content="Open audit log" Icon="{ui:SymbolIcon History24}" Command="{Binding OpenAuditCommand}" Margin="0,0,8,8" />
                        <ui:Button Content="Open reports" Icon="{ui:SymbolIcon DocumentData24}" Command="{Binding OpenReportsCommand}" Margin="0,0,8,8" />
                        <ui:Button Content="Export diagnostics…" Icon="{ui:SymbolIcon ArrowExportLtr24}" Command="{Binding ExportDiagnosticsCommand}" Margin="0,0,8,8"
                                   ToolTip="Creates a zip with redacted logs and an environment summary. No tokens or credentials are included." />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource SectionTitleText}" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyText}"><Run Text="Exchange RBAC Studio " /><Run Text="{Binding Version, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                    <TextBlock Text="{Binding RuntimeDescription}" Style="{StaticResource CaptionText}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0" Text="Administers Exchange Online RBAC for Applications. Delegated Microsoft Graph permissions: User.Read, Application.Read.All. Exchange Online is managed through an isolated PowerShell 7 process running the ExchangeOnlineManagement module." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
