<UserControl x:Class="ExchangeRbacStudio.App.Views.Wizard.ConfigureAccessWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ExchangeRbacStudio.App.ViewModels.Wizard"
             xmlns:controls="clr-namespace:ExchangeRbacStudio.App.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:ConfigureAccessWizardViewModel}"
             AutomationProperties.AutomationId="ConfigureAccessWizard">
    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleText}" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <ui:InfoBar Severity="Warning" IsClosable="False" IsOpen="True" Title="Configuration reset" Message="{Binding ResetMessage}" Margin="0,0,0,12"
                        Visibility="{Binding ResetMessage, Converter={StaticResource NullToVisibility}}" />
            <Border Style="{StaticResource Card}" Visibility="{Binding IsFullyConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <controls:EmptyState Symbol="PlugDisconnected24" Margin="0,12" Title="Connect to both Microsoft Entra ID and Exchange Online"
                                     Message="The wizard validates identities in Microsoft Entra ID and reads and changes configuration in Exchange Online, so both connections to the same tenant are required.">
                    <ui:Button Appearance="Primary" Content="Connect" Command="{Binding DataContext.Session.ConnectCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </controls:EmptyState>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Visibility="{Binding IsFullyConnected, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Stepper -->
            <ItemsControl ItemsSource="{Binding StepItems}" AutomationProperties.Name="Wizard steps" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:WizardStepItem}">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Circle" Width="28" Height="28" CornerRadius="14" BorderThickness="1"
                                    BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" Background="Transparent" VerticalAlignment="Top">
                                <Grid>
                                    <TextBlock x:Name="Number" Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:SymbolIcon x:Name="Check" Symbol="Checkmark16" FontSize="14" Visibility="Collapsed" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,3,0,10">
                                <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource CaptionText}" />
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:WizardStepState.Current}">
                                <Setter TargetName="Circle" Property="Background" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="{x:Static vm:WizardStepState.Completed}">
                                <Setter TargetName="Circle" Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Current step -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="24,20,24,12" DataContext="{Binding CurrentStep}">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleText}" AutomationProperties.HeadingLevel="Level2" AutomationProperties.AutomationId="StepTitle" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
                        <controls:ErrorPanel Error="{Binding Error}" Margin="0,12,0,0" />
                        <controls:LoadingIndicator Text="{Binding BusyMessage}" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,24,24">
                        <ContentControl Content="{Binding CurrentStep}" Focusable="False" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Navigation -->
        <Grid Grid.Row="3" Margin="264,16,0,0" Visibility="{Binding IsFullyConnected, Converter={StaticResource BoolToVisibility}}">
            <ui:Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="WizardCancel" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Back" Icon="{ui:SymbolIcon ArrowLeft24}" Command="{Binding BackCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="WizardBack" />
                <ui:Button Appearance="Primary" Command="{Binding NextCommand}" MinWidth="120" AutomationProperties.AutomationId="WizardNext"
                           Content="{Binding CurrentStep.NextLabel}" Icon="{ui:SymbolIcon ArrowRight24}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
