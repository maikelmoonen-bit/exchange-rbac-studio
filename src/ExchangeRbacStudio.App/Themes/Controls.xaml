<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:ExchangeRbacStudio.App.Controls"
                    xmlns:vm="clr-namespace:ExchangeRbacStudio.App.ViewModels">

    <!-- StatusBadge -->
    <Style TargetType="controls:StatusBadge">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:StatusBadge">
                    <Border x:Name="Root" CornerRadius="10" Padding="8,2" BorderThickness="1"
                            Background="{DynamicResource SystemFillColorNeutralBackgroundBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Text}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Kind" Value="{x:Static vm:StatusKind.Success}">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="{x:Static vm:StatusKind.Warning}">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="{x:Static vm:StatusKind.Critical}">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="{x:Static vm:StatusKind.Info}">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="{x:Static vm:StatusKind.Progress}">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- StatusGlyph -->
    <Style TargetType="controls:StatusGlyph">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:StatusGlyph">
                    <Grid>
                        <ui:SymbolIcon x:Name="Icon" Symbol="Circle24" FontSize="{Binding Width, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Filled="False" />
                        <ui:ProgressRing x:Name="Ring" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" IsIndeterminate="True" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Kind" Value="{x:Static vm:StatusKind.Success}">
                            <Setter TargetName="Icon" Property="Symbol" Value="CheckmarkCircle24" />
                            <Setter TargetName="Icon" Property="Filled" Value="True" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="{x:Static vm:StatusKind.Warning}">
                            <Setter TargetName="Icon" Property="Symbol" Value="Warning24" />
                            <Setter TargetName="Icon" Property="Filled" Value="True" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="{x:Static vm:StatusKind.Critical}">
                            <Setter TargetName="Icon" Property="Symbol" Value="DismissCircle24" />
                            <Setter TargetName="Icon" Property="Filled" Value="True" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="{x:Static vm:StatusKind.Info}">
                            <Setter TargetName="Icon" Property="Symbol" Value="Info24" />
                            <Setter TargetName="Icon" Property="Filled" Value="True" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="Kind" Value="{x:Static vm:StatusKind.Progress}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- StatusMessage -->
    <Style TargetType="controls:StatusMessage">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:StatusMessage">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:StatusGlyph Kind="{TemplateBinding Kind}" VerticalAlignment="Top" />
                        <TextBlock x:Name="Text" Grid.Column="1" Margin="10,1,0,0" Text="{TemplateBinding Text}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEmphasized" Value="True">
                            <Setter TargetName="Text" Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- EmptyState -->
    <Style TargetType="controls:EmptyState">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,48" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:EmptyState">
                    <StackPanel MaxWidth="460" HorizontalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <ui:SymbolIcon Symbol="{TemplateBinding Symbol}" FontSize="30" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="{TemplateBinding Title}" Margin="0,16,0,0" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource SectionTitleText}" TextWrapping="Wrap" />
                        <TextBlock Text="{TemplateBinding Message}" Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource SecondaryText}" />
                        <ContentPresenter Margin="0,20,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- LoadingIndicator -->
    <Style TargetType="controls:LoadingIndicator">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:LoadingIndicator">
                    <StackPanel Orientation="Horizontal">
                        <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" />
                        <TextBlock Text="{TemplateBinding Text}" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryText}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CopyableText -->
    <Style TargetType="controls:CopyableText">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:CopyableText">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="Text" Text="{TemplateBinding Text}" Style="{StaticResource ReadOnlyCodeBox}" VerticalAlignment="Center"
                                 AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}" />
                        <ui:Button Grid.Column="1" Margin="6,0,0,0" Padding="6" Appearance="Transparent" Command="{Binding CopyCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                   ToolTip="Copy to clipboard" AutomationProperties.Name="Copy" Icon="{ui:SymbolIcon Copy24}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMonospace" Value="False">
                            <Setter TargetName="Text" Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
                            <Setter TargetName="Text" Property="FontSize" Value="14" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ErrorPanel -->
    <Style TargetType="controls:ErrorPanel">
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ErrorPanel">
                    <Border x:Name="Root" CornerRadius="8" Padding="16" BorderThickness="1"
                            Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            DataContext="{TemplateBinding Error}" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="Error">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon x:Name="Icon" Symbol="ErrorCircle24" Filled="True" FontSize="20" VerticalAlignment="Top" Margin="0,1,12,0"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource SubsectionTitleText}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Message}" Margin="0,4,0,0" Style="{StaticResource BodyText}" />
                                <!-- Grid (not a horizontal StackPanel) so the hint gets a finite width and wraps in narrow dialogs. -->
                                <Grid Margin="0,8,0,0" MaxWidth="900" HorizontalAlignment="Left" Visibility="{Binding Remediation, Converter={StaticResource NullToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Lightbulb24" FontSize="16" VerticalAlignment="Top" Margin="0,1,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Remediation}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                                </Grid>
                                <Expander Margin="0,10,0,0" Header="Technical details" IsExpanded="{Binding IsDetailsExpanded}" Style="{StaticResource SubtleExpander}">
                                    <Border Style="{StaticResource CodeBlock}" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBox Text="{Binding TechnicalDetails, Mode=OneWay}" Style="{StaticResource ReadOnlyCodeBox}" MaxHeight="220" VerticalScrollBarVisibility="Auto" />
                                            <ui:Button Content="Copy diagnostics" Margin="0,10,0,0" Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopyDetailsCommand}" />
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </StackPanel>
                            <ui:Button Grid.Column="2" Appearance="Transparent" Padding="6" VerticalAlignment="Top" Icon="{ui:SymbolIcon Dismiss24}"
                                       Command="{Binding DismissCommand}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss error" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Error.IsWarning, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                            <Setter TargetName="Icon" Property="Symbol" Value="Warning24" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                        </DataTrigger>
                        <Trigger Property="Error" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
