<Application x:Class="ExchangeRbacStudio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="pack://application:,,,/ExchangeRbacStudio;component/Themes/Styles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/ExchangeRbacStudio;component/Themes/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/ExchangeRbacStudio;component/Themes/DataTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
