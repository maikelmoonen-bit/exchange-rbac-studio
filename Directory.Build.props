<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <Company>Exchange RBAC Studio</Company>
    <Product>Exchange RBAC Studio</Product>
    <Copyright>Copyright (c) 2026 Maikel Moonen</Copyright>
    <Authors>Maikel Moonen</Authors>
    <RepositoryUrl>https://github.com/maikelmoonen-bit/exchange-rbac-studio</RepositoryUrl>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Nullable correctness is treated as a hard requirement across the solution. -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
  </PropertyGroup>
</Project>
